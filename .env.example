# ─── Core ────────────────────────────────────────────────────────────────────
# Public URL of the deployment (no trailing slash). Used for Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Leave empty for in-memory dev store.
MONGODB_URI=
MONGODB_DB=stillpoint

# ─── OAuth / Email magic link ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend API key + verified sender for email magic links
AUTH_RESEND_KEY=
EMAIL_FROM=StillPoint <hello@yourdomain.com>

# ─── AI (Vercel AI Gateway) ──────────────────────────────────────────────────
# Leave empty to run the deterministic offline demo generator instead.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_MODEL_PREMIUM=anthropic/claude-3-5-sonnet

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# ─── Abuse / cost control ────────────────────────────────────────────────────
# Global AI spend cap per day (USD). The product stops calling AI above this.
SPEND_DAILY_LIMIT_USD=2
SPEND_DAILY_LIMIT_USER_USD=0.5

# Upstash Redis (free tier). If empty, an in-process limiter is used (dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Dev only ────────────────────────────────────────────────────────────────
# Enables the password-less "demo" login button and the offline generator.
# MUST stay "false" in production.
DEMO_MODE=false