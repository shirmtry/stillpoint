{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StillPoint",
  "version": "1.0.0",
  "identifier": "app.stillpoint.desktop",
  "build": {
    "frontendDist": "../src-tauri/placeholder"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StillPoint",
        "url": "https://stillpoint.vercel.app",
        "width": 1100,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Vietnamese"],
        "displayLanguageSelector": false
      }
    }
  }
}